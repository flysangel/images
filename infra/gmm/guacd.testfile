#!/bin/bash
# 煙霧測試 for gmm:guacd-vX (Guacamole proxy daemon)
set -euo pipefail

img_tag="${1:?usage: bash testfile <family>:<tag>}"
echo "[test] starting ${img_tag}"

sudo podman run --rm --privileged --network bridge --name repotest -d "${REGISTRY_PREFIX:?REGISTRY_PREFIX 未設(由 img.sh test/ci 注入,或先 export)}/${img_tag}"
trap 'sudo podman stop repotest >/dev/null 2>&1 || true' EXIT

for _ in $(seq 1 30); do
    if sudo podman exec repotest sh -c 'ss -lnt 2>/dev/null | grep -q :4822 || netstat -lnt 2>/dev/null | grep -q :4822'; then
        break
    fi
    sleep 2
done

# 1) port 4822 listen
sudo podman exec repotest sh -c \
    'ss -lnt 2>/dev/null | grep :4822 || netstat -lnt 2>/dev/null | grep :4822' >/dev/null \
    || { echo "[FAIL] guacd not listening on :4822" >&2; exit 1; }

# 2) guacd binary 存在(image 將其裝於 /opt/guacamole/sbin/,非 PATH)
sudo podman exec repotest sh -c 'test -x /opt/guacamole/sbin/guacd' \
    || { echo "[FAIL] /opt/guacamole/sbin/guacd missing or not executable" >&2; exit 1; }

echo "[OK] ${img_tag} smoke test passed"
