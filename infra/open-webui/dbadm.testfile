#!/bin/bash
# 煙霧測試 for open-webui:dbadm-vX
# 驗 sqlite + 4 個 helper script (adduser/deluser/lsuser/resetpasswd) + htpasswd
set -euo pipefail

img_tag="${1:?usage: bash testfile <family>:<tag>}"
echo "[test] starting ${img_tag}"

sudo podman run --rm --privileged --network bridge --name repotest -d "${REGISTRY_PREFIX:?REGISTRY_PREFIX 未設(由 img.sh test/ci 注入,或先 export)}/${img_tag}"
trap 'sudo podman stop repotest >/dev/null 2>&1 || true' EXIT

# 1) 4 個 helper script 都已 COPY 進 /bin 並可執行
for script in adduser.sh deluser.sh lsuser.sh resetpasswd.sh; do
    sudo podman exec repotest sh -c "test -x /bin/${script}" \
        || { echo "[FAIL] /bin/${script} not executable" >&2; exit 1; }
done

# 2) 工具 binary
for bin in sqlite3 htpasswd uuidgen nano; do
    sudo podman exec repotest sh -c "command -v ${bin}" >/dev/null \
        || { echo "[FAIL] ${bin} not in PATH" >&2; exit 1; }
done

echo "[OK] ${img_tag} smoke test passed"
