#!/bin/bash
# 煙霧測試 for landlord:gateway-vX —— 驗 sshpass + adduser 就位
set -euo pipefail
img_tag="${1:?usage: bash testfile <family>:<tag>}"
echo "[test] ${img_tag}"
out="$(sudo podman run --rm --entrypoint /bin/bash "${REGISTRY_PREFIX:?}/${img_tag}" -c 'command -v sshpass; ls /bin/adduser' 2>&1)" || true
echo "${out}"
grep -q '/bin/adduser' <<<"${out}" && grep -q 'sshpass' <<<"${out}" || { echo "[FAIL] gateway sshpass/adduser 缺" >&2; exit 1; }
echo "[OK] ${img_tag} gateway 煙霧測試通過"
