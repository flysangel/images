#!/bin/bash
# 煙霧測試 for landlord:mariadb-vX —— 驗 initdb.sql 就位
set -euo pipefail
img_tag="${1:?usage: bash testfile <family>:<tag>}"
echo "[test] ${img_tag}"
out="$(sudo podman run --rm --entrypoint /bin/sh "${REGISTRY_PREFIX:?}/${img_tag}" -c 'ls /docker-entrypoint-initdb.d/initdb.sql' 2>&1)" || true
echo "${out}"
grep -q 'initdb.sql' <<<"${out}" || { echo "[FAIL] mariadb initdb.sql 缺" >&2; exit 1; }
echo "[OK] ${img_tag} mariadb 煙霧測試通過"
