#!/bin/bash
# HA 啟動順序固定：兩台 NameNode 先起 journalnode；active 等 standby 可 ping 後 format、起 namenode、formatZK、起 zkfc；
# standby 等 active 後 bootstrapStandby、起 namenode、起 zkfc。format 以 echo N 回答「重新格式化？」，重啟不洗資料。

log() {
  echo "$(date "+%Y-%m-%d %H:%M:%S") INFO ${1}"
}

waitserver() {
  while true; do
    log "Wait ${1}"
    ping -c 2 "${1}" &>/dev/null && break
    sleep "${WAIT}"
  done
}

ZOOKEEPERS=${ZOOKEEPER//:2181/}
echo "${ZOOKEEPERS//,/ }" "${NAMENODE}" "${NAMENODE_STBY}" "${RESOURCEMANAGER}" "${RESOURCEMANAGER_STBY}" "${HISTORYSERVER}" |
  xargs -n 1 | while read -r server; do
  waitserver "${server}"
done

if echo "${NAMENODE}" | grep -qw "$(hostname)"; then
  hdfs --daemon start journalnode
  sleep "${WAIT}" && jps -m | grep -q 'JournalNode' && log "Started JournalNode on [$(hostname)]"

  waitserver "${NAMENODE_STBY}"
  echo -e "N\n" | hdfs namenode -format
  hdfs --daemon start namenode
  sleep "${WAIT}" && jps -m | grep -q 'NameNode' && log "Started NameNode on [$(hostname)]"

  echo -e "N\n" | hdfs zkfc -formatZK
  hdfs --daemon start zkfc
  sleep "${WAIT}" && jps -m | grep -q 'DFSZKFailoverController' && log "Started DFSZKFailoverController on [$(hostname)]"
fi

if echo "${NAMENODE_STBY}" | grep -qw "$(hostname)"; then
  hdfs --daemon start journalnode
  sleep "${WAIT}" && jps -m | grep -q 'JournalNode' && log "Started JournalNode on [$(hostname)]"

  waitserver "${NAMENODE}"
  echo -e "N\n" | hdfs namenode -bootstrapStandby
  hdfs --daemon start namenode
  sleep "${WAIT}" && jps -m | grep -q 'NameNode' && log "Started NameNode on [$(hostname)]"

  hdfs --daemon start zkfc
  sleep "${WAIT}" && jps -m | grep -q 'DFSZKFailoverController' && log "Started DFSZKFailoverController on [$(hostname)]"
fi

if echo "${RESOURCEMANAGER}" | grep -qw "$(hostname)"; then
  yarn --daemon start resourcemanager
  sleep "${WAIT}" && jps -m | grep -q 'ResourceManager' && log "Started ResourceManager on [$(hostname)]"
fi

if echo "${RESOURCEMANAGER_STBY}" | grep -qw "$(hostname)"; then
  yarn --daemon start resourcemanager
  sleep "${WAIT}" && jps -m | grep -q 'ResourceManager' && log "Started ResourceManager on [$(hostname)]"
fi

if echo "${HISTORYSERVER}" | grep -qw "$(hostname)"; then
  mapred --daemon start historyserver
  sleep "${WAIT}" && jps -m | grep -q 'JobHistoryServer' && log "Started JobHistoryServer on [$(hostname)]"
fi

if echo "${WORKERNODE}" | grep -qw "$(hostname)"; then
  hdfs --daemon start datanode
  sleep "${WAIT}" && jps -m | grep -q 'DataNode' && log "Started DataNode on [$(hostname)]"

  yarn --daemon start nodemanager
  sleep "${WAIT}" && jps -m | grep -q 'NodeManager' && log "Started NodeManager on [$(hostname)]"
fi
