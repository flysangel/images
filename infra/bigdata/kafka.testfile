#!/bin/bash
# 煙霧測試 for bigdata:kafka-vX —— 驗 Kafka 3.7.0
set -euo pipefail
img_tag="${1:?usage: bash testfile <family>:<tag>}"
echo "[test] ${img_tag}"
out="$(sudo podman run --rm "${REGISTRY_PREFIX:?}/${img_tag}" bash -lc '"$KAFKA_HOME"/bin/kafka-topics.sh --version' 2>&1)" || true
echo "${out}"
grep -q '3\.7\.0' <<<"${out}" || { echo "[FAIL] kafka 3.7.0 未找到" >&2; exit 1; }
echo "[OK] ${img_tag} kafka 煙霧測試通過"
