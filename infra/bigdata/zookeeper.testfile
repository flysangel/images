#!/bin/bash
# 煙霧測試 for bigdata:zookeeper-vX —— 驗 ZooKeeper 3.8.4
set -euo pipefail
img_tag="${1:?usage: bash testfile <family>:<tag>}"
echo "[test] ${img_tag}"
out="$(sudo podman run --rm "${REGISTRY_PREFIX:?}/${img_tag}" bash -lc '"$ZOOKEEPER_HOME"/bin/zkServer.sh version' 2>&1)" || true
echo "${out}"
grep -q '3\.8\.4' <<<"${out}" || { echo "[FAIL] zookeeper 3.8.4 未找到" >&2; exit 1; }
echo "[OK] ${img_tag} zookeeper 煙霧測試通過"
