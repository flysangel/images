#!/bin/bash
# 煙霧測試 for bigdata:hadoop-vX —— 驗 Hadoop 3.4.0
set -euo pipefail
img_tag="${1:?usage: bash testfile <family>:<tag>}"
echo "[test] ${img_tag}"
out="$(sudo podman run --rm "${REGISTRY_PREFIX:?}/${img_tag}" bash -lc 'hadoop version' 2>&1)" || true
echo "${out}"
grep -q 'Hadoop 3\.4\.0' <<<"${out}" || { echo "[FAIL] Hadoop 3.4.0 未找到" >&2; exit 1; }
echo "[OK] ${img_tag} hadoop 煙霧測試通過"
