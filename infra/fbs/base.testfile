#!/bin/bash
# 煙霧測試 for fbs:base-vX
# 驗 filebrowser 在 :4000 listen 並回應 HTTP（admin/admin 設定見 docker_config.json）
set -euo pipefail

img_tag="${1:?usage: bash testfile <family>:<tag>}"
echo "[test] starting ${img_tag}"

sudo podman run --rm --privileged --network bridge --name repotest -d "${REGISTRY_PREFIX:?REGISTRY_PREFIX 未設(由 img.sh test/ci 注入,或先 export)}/${img_tag}"
trap 'sudo podman stop repotest >/dev/null 2>&1 || true' EXIT

# 等 filebrowser 起來（最多 60s）
for _ in $(seq 1 30); do
    if sudo podman exec repotest sh -c 'ss -lnt 2>/dev/null | grep -q :4000 || netstat -lnt 2>/dev/null | grep -q :4000'; then
        break
    fi
    sleep 2
done

# 1) port 4000 listen
sudo podman exec repotest sh -c \
    'ss -lnt 2>/dev/null | grep :4000 || netstat -lnt 2>/dev/null | grep :4000' >/dev/null \
    || { echo "[FAIL] filebrowser not listening on :4000" >&2; exit 1; }

# 2) HTTP 回應（filebrowser 預設 / 應 redirect 到 /login，回 200/302/308）
http_code="$(sudo podman exec repotest sh -c 'curl -fsSL -o /dev/null -w "%{http_code}" http://localhost:4000/' 2>/dev/null || true)"
case "${http_code}" in
    200|301|302|307|308) ;;
    *)
        echo "[FAIL] filebrowser HTTP / returned ${http_code} (expected 2xx/3xx)" >&2
        exit 1
        ;;
esac

# 3) filebrowser binary 存在
sudo podman exec repotest sh -c 'command -v filebrowser' >/dev/null \
    || { echo "[FAIL] filebrowser not in PATH" >&2; exit 1; }

echo "[OK] ${img_tag} smoke test passed"
